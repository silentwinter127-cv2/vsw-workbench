<?xml version="1.0" encoding="utf-8"?>
<!-- 前景层：三个取景角 + 一个搜索圆点（与网页里的 logo 一致）。
     自适应图标的安全区是中间 66%，所以图形收在 108dp 画布的中段。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左上角 -->
    <path
        android:strokeColor="#4EA1FF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M34,26 L26,26 L26,34" />
    <!-- 右上角 -->
    <path
        android:strokeColor="#4EA1FF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M74,26 L82,26 L82,34" />
    <!-- 左下角 -->
    <path
        android:strokeColor="#4EA1FF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M34,82 L26,82 L26,74" />
    <!-- 右下角 -->
    <path
        android:strokeColor="#4EA1FF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M74,82 L82,82 L82,74" />
    <!-- 扫描线 -->
    <path
        android:strokeColor="#4EA1FF"
        android:strokeWidth="3"
        android:strokeAlpha="0.55"
        android:pathData="M30,54 L78,54" />
    <!-- 搜索圆点 -->
    <path
        android:fillColor="#59D9A4"
        android:pathData="M62,54 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
</vector>
